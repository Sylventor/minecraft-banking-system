# Copy to a private .env and replace each placeholder. Never commit .env.
POSTGRES_DB=horizon
POSTGRES_SUPERUSER_PASSWORD=replace-with-long-random-value
FINANCE_DB_PASSWORD=replace-with-different-long-random-value
AUTH_DB_PASSWORD=replace-with-different-long-random-value
FINANCE_DATABASE_URL=postgresql://horizon_finance:replace-me@postgres:5432/horizon
AUTH_DATABASE_URL=postgresql+asyncpg://horizon_auth:replace-me@postgres:5432/horizon
GRPC_BIND_ADDRESS=0.0.0.0:50051
GRPC_TARGET=core:50051
INTERNAL_GRPC_TOKEN=replace-with-at-least-32-random-bytes
API_KEY_PEPPER=replace-with-at-least-32-random-bytes
DISCORD_BOT_INTERNAL_TOKEN=replace-with-at-least-32-random-bytes
DISCORD_BOT_TOKEN=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
# Optional. Leave empty until a trusted online-mode Minecraft verifier is deployed.
MINECRAFT_VERIFIER_TOKEN=
# Optional ATM service. Generate a DIFFERENT secret with: openssl rand -hex 32
ATM_SERVICE_TOKEN=
ATM_IDENTITY_MODE=online-mode
ATM_CONFIG_DIR=./atm
# Add atm to COMPOSE_PROFILES to start it on every docker compose up.
# COMPOSE_PROFILES=bot,atm
DISCORD_REDIRECT_URI=https://bank.example.com/api/v1/auth/discord/callback
PUBLIC_ORIGIN=https://bank.example.com
CORS_ORIGINS=https://bank.example.com
ENVIRONMENT=production
MAX_REQUEST_BYTES=1048576
RATE_LIMIT_PER_MINUTE=120
HORIZON_INITIAL_ISSUANCE_ACCOUNT_ID=00000000-0000-0000-0000-000000000001
BACKUP_DIR=/var/backups/horizon-bank
BACKUP_PGSERVICE=horizon-backup
PGSERVICEFILE=/etc/horizon-bank/pg_service.conf
PGPASSFILE=/etc/horizon-bank/pgpass
BACKUP_RETENTION_DAYS=7

# Public display values are not secrets.
PROJECT_NAME=Minecraft Banking System
VITE_PROJECT_NAME=Banking System
VITE_SERVER_URL=
VITE_BANK_LOGO_URL=
